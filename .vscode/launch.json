{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CMake target (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "cwd": "${workspaceFolder}",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable GDB pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "windows": {
        "miDebuggerPath": "${workspaceFolder}/tools/mingw64/bin/gdb.exe",
        "environment": [
          {
            "name": "PATH",
            "value": "${workspaceFolder}/tools/mingw64/bin;${env:PATH}"
          }
        ]
      },
      "linux": {
        "miDebuggerPath": "${workspaceFolder}/tools/linux-x64/xpack-gcc-15.2.0-1/bin/gdb"
      }
    }
  ]
}
